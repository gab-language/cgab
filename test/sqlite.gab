Dbrow := 'github.com/gab-language/cgab@0.1.5'.use 'Dbrow'

db := Dbrow.make.unwrap

"Opened $.".sprintf(db).println

db.eval "CREATE TABLE Employees (
    EmployeeID INT PRIMARY KEY,
    FirstName VARCHAR(50),
    LastName VARCHAR(50),
    HireDate DATE
);"

