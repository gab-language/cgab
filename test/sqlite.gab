res := [db.eval "SELECT * FROM Employees;"]
res.println

res := [
  db.eval(
    "SELECT * FROM Employees WHERE EmployeeID = $ID;"
    "$ID" 1
  )
]
res.println

stmt := db.query(
            "SELECT * FROM Employees WHERE EmployeeID > $ID;"
            "$ID" 0
         ).unwrap


# Not an *efficient* thing to do but it does work
# Each seq/init, seq/next has to hold/release the mutex
workers := Ranges
  .make(0 10)
  .map(() :: Fibers.make () :: do
    stmt.collect .or []
  end)

workers.println

res := workers.map(w :: w.await.unwrap).join []

res.println
res.len.println # Should be 164 - same as highest id
