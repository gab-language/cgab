Http := 'github.com/gab-language/cgab@0.1.6' .use 'Http'
'github.com/gab-language/cgab@0.1.6' .use 'Json'
'github.com/gab-language/cgab@0.1.6' .use 'czstd'

res := Http.get(
    'api.restful-api.dev'
    '/objects'
    {
      "Host" "api.restful-api.dev"
      "User-Agent" "Mozilla/5.0 (X11; Linux x86_64; rv:154.0) Gecko/20100101 Firefox/154.0"
      "Accept" "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
      "Accept-Language" "en-US,en;q=0.9"
      "Accept-Encoding" "zstd"
      "Connection" "close"
      "Upgrade-Insecure-Requests" "1"
      "Sec-Fetch-Dest" "document"
      "Sec-Fetch-Mode" "navigate"
      "Sec-Fetch-Site" "none"
      "Priority" "u=0, i"
    }).unwrap

res.println

'$ $\n'.printf(res.http\body.as\string)

'$ $\n'.printf(res.http\body.as\zstd.unwrap.as\string.unwrap.as\json)

decompressed := res.http\body.as\zstd.unwrap

'$ $\n'.printf(decompressed.as\string)

compressed := decompressed.to\zstd

compressed.println

'$ $\n'.printf(compressed.as\zstd.unwrap.as\string.unwrap.as\json)
