'github.com/gab-language/cgab@0.1.6'.use'chttp'
Socket := Io.Sockets

cert := Io.Files.make("MyCertificate.crt" "r").unwrap
pkey := Io.Files.make("MyKey.key" "r").unwrap

(ok, cert) := cert.stream\recv(cert.len)

ok.else () :: 'Invalid cert: $ ($)'.panicf(cert, cert.len)

(ok, pkey) := pkey.stream\recv(pkey.len)

ok.else () :: 'Invalid pkey: $ ($)'.panicf(cert, cert.len)

port := 1247

server_fiber := Fibers.make () :: do
  server := Socket.make tcp\tls: .unwrap

  server
    .bind("::1" port cert pkey)
    .unwrap

  server
    .listen 5
    .unwrap

  'SERVER LISTENING ON ::1 443'.println

  Fibers.make () :: do
    client := server
      .accept
      .unwrap

    'Accepted client: $\n'.sprintf(client).println

    req := client.transduce(
      nil:
      (x y) :: y
      # Concatenate the stream of bytes together
      Transducers.reduce(
          ("".to\binary)
          (x y) :: x.as\string.unwrap + y.as\string.unwrap)
      # Drop values which don't end in the empty header
      |> Transducers.drop_while(x :: x.has\suffix('\r\n\r\n').!)
      # Take the first value which *does* have an empty header. Thems the request
      |> Transducers.take 1)

    'CLIENT SENT:\n$\n'.psprintf(req.to\binary.as\http.unwrap).println

    client.stream\send(req.to\binary)

    client.close
  end
end

server_fiber.await

req := 'GET / HTTP/1.1\r\nHost:www.google.com\r\n\r\n'

sock := Socket
  .make tcp\tls:
  .unwrap

sock
  .connect("::1" port cert)
  .unwrap

sock
  .stream\send(req.to\binary)
  .unwrap

data := sock.collect("").unwrap.as\s.unwrap

#sock := Socket
#  .make tcp:
#  .unwrap
#
#sock
#  .connect("www.google.com" 80)
#  .unwrap
#
#sock
#  .write(req.to\b)
#  .unwrap

# In practice, this reads until the socket is closed.
#data := sock.until('\0'.to\b).unwrap.as\s.unwrap

http_res := data
  .as\http
  .unwrap

'STATUS: $\nHEADERS:\n$\nBODY:\n$'
  .sprintf(
    http_res.http\status
    http_res.http\headers.join(
      ""
      Transducers.map((value field) :: do
        '$: $'.sprintf(field value)
      end)
      |> Transducers.interpose '\n')
    http_res.http\body)
  .println
