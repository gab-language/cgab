do\atom\loop: .defcase {
  ok: (reply, f, loop, state) :: do
    new_state := f.(state)
    reply <! new_state
    loop.(new_state)
  end
  none: none:
}

make: .def (module, (initial) :: do
  ch := Channels.make

  loop := (state) :: do
    ch
      .>!
      .do\atom\loop(self, state)
  end

  Fibers.make () :: loop.(initial)

  ch
end)

t: .def (module, Channels.t)

[module.t] .defmodule {
  atom\deref: () :: do
    reply := Channels.make
    self <! (reply, (x) :: x)
    reply.>!.unwrap
  end

  atom\swap: (f) :: do
    reply := Channels.make
    self <! (reply, f)
    reply.>!.unwrap
  end

  atom\reset: (val) :: self.atom\swap(() :: val)
}
