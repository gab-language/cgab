eprintln:.def () :: module.stderr.stream\send('$\n'.psprintf(self).to\binary)
println:.def () :: module.stdout.stream\send('$\n'.psprintf(self).to\binary)

printf:.def(
  Strings.t
  (args*) :: do
    module.stdout.stream\send(self.psprintf(args*).to\binary)
  end)

[module.Sockets.t, module.Files.t] .defmodule {
  <!: (arg) :: do 
    self.stream\send(arg.to\string.to\binary)
    self
  end
  >!: () :: do
    self.stream\recv 1
  end
  seq\init: _ :: do
    (ok, bytes) := self >!
    (ok, nil:, bytes)
  end
  seq\next: _ :: do
    (ok, bytes) := self >!
    (ok, nil:, bytes)
  end
}

module.Sockets.t.defseq
module.Files.t.defseq
