make\from: .def (
  module,
  (shape, f) :: do
    shape.reduce({}, (r, k) :: r.put(k, f.(k)))
  end)

[module.t] .defmodule {
  has: key :: do
    self.at key .ok
  end

  : key :: self.at key .unwrap

  put_by: (k f) :: do
    (ok, v) := self.at k
    self.put(k, f.to\block.(ok .and v .or nil:))
  end

  put_via_by: (path*, f) :: do
    (ok, v) := self.at_via(path*)
    self.put_via(path*, f.to\block.(ok .and v .or nil:))
  end

  is\record: true:
}

is\record: .def false:

() :: do
  keys := self.keys.sort
end

list\sort: .defcase {
  []?
  []

  module.t
  (f) :: do
    (tail head) := self.pop

    smaller := tail.filter(a :: f.(a) <= f.(head)).sort
    bigger := tail.filter(a :: f.(a) > f.(head)).sort

    smaller
      .push head
      .+ bigger
  end
}

record\sort: .def(
  module.t,
  (f) :: do
    keys := self.keys.sort f

    shp := Shapes.make(keys*)

    module.make\from(shp, self)
  end)

dosort:.defcase {
  true: (rec, f) :: rec.list\sort f
  false: (rec, f) :: rec.record\sort f
}

to\sorter: .defcase {
  nil:      () :: (x :: x)
  Blocks.t, () :: self
}

sort:.def(
  module.t,
  (f) :: self.is\list.dosort(self, f.to\sorter))
