Dbrow := 'github.com/gab-language/cgab@0.1.6'.use 'csqlite'

Query := Dbrow.Query

[Dbrow.t] .defmodule {
  eval: (sql, vars*) :: do
    stmt := self.query(sql, vars*).unwrap
    stmt.collect
  end
}

[Query.t] .defmodule {
  seq\init: _ :: do
    (ok, xs*) := self >!
    (ok, nil:, xs*)
  end
  seq\next: _ :: do
    (ok, xs*) := self >!
    (ok, nil:, xs*)
  end
}

Query.t.defseq

Dbrow
