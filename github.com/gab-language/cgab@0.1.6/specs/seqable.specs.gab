s := 'github.com/gab-language/cgab@0.1.6'.use 'Specs'
'github.com/gab-language/cgab@0.1.6/specs'.use 'transduceable.specs'

seqable\spec := seqable: .defspec {
  help:
  "
  The `seqable` protocol defines how a value should produce a lazy sequence of other values.

  To use the `seqable` protocol, begin by sending `seq\init`:

  ```gab
    (ok next values*) := ['1' '2' '3' '4'].seq\init
  ```

  *ok* will contain `ok:` or `none:`. This determines whether or not the sequence had an initial value.

  It follows that empty sequences return `none:` when `seq\init` is sent.

  Non-empty sequences will return `ok:`, followed by *next* (more on that later), followed by a run of values.

  The run of values can be any number of values. Records return `(value, key)`, so for the above example:

  ```gab
    ok     # :: ok:
    next   # :: 1
    values # :: ['1', 0] (values collects the tuple into a list)
  ```

  The *next* value is a key which the user can pass to `seq\next:` to receive the *next* iteration in the sequence.

  This is what makes the sequence lazy - the user computes the next value only when they need it.

  ```gab
    (ok next values*) := ['1' '2' '3' '4'].seq\next 1

    ok     # :: ok: 
    next   # :: 2
    values # :: ['2', 1]
  ```
  "
  spec: s.protocol (
    seq\init:
    seq\next:
  )
}

seqable\seq\init: .defspec {
  help: 'Return the initial key and value which should begin the sequence.'
  spec: s.message {
    receiver:  seqable\spec
    message:   seq\init:
    input:     s.cat()
    output:    s.alt(
      'next'   s.cat(
        'status'  ok:
        'key'     s.unknown
        'values'  s*s.unknown
      )
      'done'   s.cat(
        'status' none:
      )
    )
  }
}

seqable\seq\next: .defspec {
  help: 'Given a key, return the next keys and values which would continue the sequence.'
  spec: s.message {
    receiver:  seqable\spec
    message:   seq\next:
    input:     s.cat('key' s.unknown)
    output:    s.alt(
      'next'   s.cat(
        'status'  ok:
        'key'     s.unknown
        'values'  s*s.unknown
      )
      'done'   s.cat(
        'status' none:
      )
    )

  }
}

seqable\defseq: .defspec {
  help:
  "
  Types that implement the `seqable` protocol may use `defseq` to implement a slew of useful messages.

  ```gab
  [my_type] .defmodule {
    seq\init: ...some_impl
    seq\next: ...some_impl
  }

  # Now send defseq to implement the useful messages
  my_type.defseq
  ```
  "
  spec: s.message {
    receiver: seqable\spec
    message:  defseq:
    input:    s.cat()
    output:   s.cat()
  }
}

seqable\reduce: .defspec {
  help:
  "
  Eagerly consume the values in `seqable` and reduce applying `f`, starting with `initial`.

  ```gab
  nums := [ 1,2,3,4,5 ]

  sum := nums.reduce(0 (x y) :: x + y)
  ```
  "
  spec: s.message {
    receiver: seqable\spec
    message:  reduce:
    input:    s.cat('initial' s.unknown, 'f' s.block { input: s.cat(s.unknown, s.unknown), output: s.unknown })
    output:   s.unknown
  }
}

seqable\transduce: .defspec {
  help:
  "
  Eagerly consume the values in `seqable` like `reduce`, but first wrap reducer `f` with transducer `xf`.

  ```gab
  nums := [ 1,2,3,4,5 ]

  sum := nums.transduce(0 (x y) :: x + y, Transducers.map(x :: x++))
  # 20 instead of 10
  ```
  "
  spec: s.message {
    receiver: seqable\spec
    message:  transduce:
    input:    s.cat('initial' s.unknown, 'f' s.block { input: s.cat(s.unknown, s.unknown), output: s.unknown }, 'xf' transduceable:.spec)
    output:   s.unknown
  }
}

seqable\each: .defspec {
  help:
  "
  Eagerly consume the tuples in `seqable`, calling `f` with each tuple.

  ```gab
  nums := [ 1,2,3,4,5 ]

  nums.each(x :: x.println)
  # 1
  # 2
  # 3
  # 4
  # 5
  ```
  "
  spec: s.message {
    receiver: seqable\spec
    message:  each:
    input:    s.cat('f' s.block { input: s.cat(s.unknown), output: s.cat() } )
    output:   s.cat
  }
}

seqable\map: .defspec {
  help:
  "
  See Transducers/map
  "
  spec: s.message {
    receiver: seqable\spec
    message:  map:
    input:    s.cat('f' s.block { input: s.unknown, output: s.unknown } )
    output:   s.list(s.unknown)
  }
}

seqable\filter: .defspec {
  help:
  "
  See Transducers/filter
  "
  spec: s.message {
    receiver: seqable\spec
    message:  filter:
    input:    s.cat('f' s.block { input: s.unknown, output: s.boolean })
    output:   s.list(s.unknown)
  }
}

seqable\mapfilter: .defspec {
  help:
  "
  See Transducers/mapfilter
  "
  spec: s.message {
    receiver: seqable\spec
    message:  filter:
    input:    s.cat('f' s.block { input: s.unknown, output: s.cat('should_include' s.boolean, 'values' s.unknown)})
    output:   s.list(s.unknown)
  }
}

seqable\skip: .defspec {
  help:
  "
  See Transducers/skip
  "
  spec: s.message {
    receiver: seqable\spec
    message:  skip:
    input:    s.cat('f' s.block { input: s.unknown, output: s.boolean })
    output:   s.list(s.unknown)
  }
}

seqable\every: .defspec {
  help:
  "
  Eagerly consumes all values in seq until `f` returns `false:`.

  Returns `true:` if `f` returned `true:` for all values in the seq, and `false:` otherwise.
  "
  spec: s.message {
    receiver: seqable\spec
    message:  every:
    input:    s.cat('f' s.block { input: s.unknown, output: s.boolean })
    output:   s.boolean
  }
}

seqable\any: .defspec {
  help:
  "
  Eagerly consumes all values in seq until `f` returns `true:`.

  Returns `true:` if `f` returned `true:` for any value in the seq, and `false:` otherwise.
  "
  spec: s.message {
    receiver: seqable\spec
    message:  any:
    input:    s.cat('f' s.block { input: s.unknown, output: s.boolean })
    output:   s.boolean
  }
}

seqable\join: .defspec {
  help:
  "
  Eagerly consumes all values in seq, appending them to `initial` with `+:`.

  ```gab
  words := [ 'hello' 'world,' 'my' 'name' 'is' 'Joe']
  
  message := words.join('')
  # 'helloworld,mynameisJoe'

  # Use transducers to interpose a space, making a nice looking sentence!
  message := words.join('', Transducers.interpose ' ')
  # 'hello world, my name is Joe'
  ```
  "
  spec: s.message {
    receiver: seqable\spec
    message:  join:
    input:    s.cat('initial' s.unknown, 'xf' transduceable:.spec)
    output:   s.unknown
  }
}

seqable\collect: .defspec {
  help:
  "
  Eagerly consumes all values in seq, appending them to `initial` with `cons:`.

  ```gab
  word := 'helloworld'
  
  letters := word.collect [] 
  # ['h' 'e' 'l' 'l' 'o' 'w' 'o' 'r' 'l' 'd']
  ```
  "
  spec: s.message {
    receiver: seqable\spec
    message:  collect:
    input:    s.cat('initial' s.unknown, 'xf' transduceable:.spec)
    output:   s.unknown
  }
}

seqable\zip: .defspec {
  help:
  "
  Eagerly consumes all values in seq, appending them to `initial` with `put_via:`.

  ```gab
  ch := Channels.make

  Fibers.make () :: do
    ch <! (dog: red: 'clifford')
    ch <! (dog: blue: 'bluey')
    ch.close
  end

  animals := ch.zip {}
  # { dog: { red: 'clifford' blue: 'bluey } } 
  ```
  "
  spec: s.message {
    receiver: seqable\spec
    message:  zip:
    input:    s.cat('initial' s.unknown, 'xf' transduceable:.spec)
    output:   s.unknown
  }
}

seqable\pipe: .defspec {
  help:
  "
  Eagerly consumes all values in seq, appending them to `initial` with `<!:`.

  ```gab
  nums := [ 1 2 3 4 5 ]
  
  # Put nums onto channel, but use a transducer to only bring the even ones across.
  nums.pipe(some_channel, Transducers.filter(x :: x.is\even))
  ```
  "
  spec: s.message {
    receiver: seqable\spec
    message:  pipe:
    input:    s.cat('initial' s.unknown, 'xf' transduceable:.spec)
    output:   s.unknown
  }
}
