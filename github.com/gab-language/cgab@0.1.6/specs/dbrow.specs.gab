s := 'github.com/gab-language/cgab@0.1.6'.use 'Specs'

dbrow := dbrow: .defspec {
  help:
  "
  A connection to a row-based database. This implementation wraps sqlite.
  "
  spec: s.box "db\row"
}

dbrow\stmt := dbrow\stmt: .defspec {
  help:
  "
  A compiled sql statement.

  Implements the seqable protocol.
  "
  spec: s.box "db\row\stmt"
}

dbrow\stmt\source: .defspec {
  help:
  "
  Lazily produce the next row from the query.

  See the sourceable protocol.
  "
  spec: s.message {
    receiver: dbrow\stmt
    input: s.cat
    message: >!:
    output: s.option(s.unknown)
  }
}

dbrow\stmt\seq\init: .defspec {
  help:
  "
  Begin iterating the result rows of a query. Lazily produces rows as requested.

  Implemented using the sourceable protocol.

  See the seqable protocol.
  "
  spec: s.message {
    receiver: dbrow\stmt
    input: s.cat
    message: seq\init:
    output: s.option(s.unknown)
  }
}

dbrow\stmt\seq\next: .defspec {
  help:
  "
  Continue iterating the result rows of a query. Lazily produces rows as requested.

  Implemented using the sourceable protocol.

  See the seqable protocol.
  "
  spec: s.message {
    receiver: dbrow\stmt
    input: s.cat
    message: seq\next:
    output: s.option(s.unknown)
  }
}

dbrow\query: .defspec {
  help:
  "
  Compile the input query (really, this can be any statement).

  Returns an error if compilation fails.
  "
  spec: s.message {
    receiver: dbrow
    input: s.string
    message: query:
    output: s.result(s.cat(s.*(s.unknown)), s.string)
  }
}

dbrow\eval: .defspec {
  help:
  "
  Evaluate the sql string argument against the database `self`.

  Does this by creating a query and sending `collect` to it. Will panic if the query fails to create.
  "
  spec: s.message {
    receiver: dbrow
    input: s.string
    message: eval:
    output: s.result(s.cat(s.*(s.unknown)), s.string)
  }
}
