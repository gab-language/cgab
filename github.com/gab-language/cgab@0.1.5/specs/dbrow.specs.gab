s := 'github.com/gab-language/cgab@0.1.5'.use 'Specs'

dbrow: .defspec {
  help:
  "
  A connection to a row-based database. This implementation wraps sqlite.
  "
  spec: s.box "db\row"
}

dbrow\stmt: .defspec {
  help:
  "
  A compiled sql statement.

  Implements the seqable protocol.
  "
  spec: s.box "db\row\stmt"
}

dbrow\query: .defspec {
  help:
  "
  Compile the input query (really, this can be any statement).

  Returns an error if compilation fails.
  "
  spec: s.message {
    receiver: dbrow:
    input: s.string
    message: query:
    output: s.result(s.cat(s.*(s.unknown)), s.string)
  }
}

dbrow\eval: .defspec {
  help:
  "
  Evaluate the sql string argument against the database `self`.
  "
  spec: s.message {
    receiver: dbrow:
    input: s.string
    message: eval:
    output: s.result(s.cat(s.*(s.unknown)), s.string)
  }
}
