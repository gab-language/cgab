json := 'github.com/gab-language/cgab@0.1.5' .use 'cjson'
Transducers := 'github.com/gab-language/cgab@0.1.5' .use 'Transducers'

array_xf := Transducers.map(e :: e.to\json)
        |> Transducers.interpose ","

object_xf := Transducers.map((v k) :: k.to\json + ":" + v.to\json)
         |> Transducers.interpose ","

json\do_encode_record: .defcase {
  true: array :: Strings.make("[", array.join("" array_xf), "]")
  false: object :: Strings.make("{", object.join("" object_xf), "}")
}

to\json: .defcase {
  nil:          'null'
  true:         'true'
  false:        'false'
  Numbers.t
  () :: self.to\string

  Messages.t
  () :: self.to\string.to\json

  Strings.t
  () :: Strings.make('"' self '"')

  Records.t
  () :: self.is\list.json\do_encode_record self
}

json
